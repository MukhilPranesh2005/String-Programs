import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc=new Scanner(System.in);
		int n=6;
		String str=sc.nextLine();
	    //string repeat
	    StringBuilder sb=new StringBuilder();
	    for(int i=0;i<n;i++)
	    {
	        sb.append(str);
	    }
	    System.out.print(sb.toString());
		

	}
}
